# Kept out of the archive Composer installs (`git archive`, dist downloads):
# what a consumer of the bundle needs is src/, config/, assets/, templates/,
# skeleton/ (what make:sdc-component generates from), composer.json and the
# documentation (README.md, docs/, UPGRADE.md, CHANGELOG.md, LICENSE.md, and
# benchmark.md, which docs/ links to).

# Repository metadata
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore

# Tests, benchmarks and the end-to-end setup
/tests export-ignore
/tests_e2e export-ignore
/e2e-test export-ignore
/phpunit.xml.dist export-ignore
/phpbench.json export-ignore
/phpbench.json.dist export-ignore

# Tooling configuration
/phpstan.neon export-ignore
/phpstan.neon.dist export-ignore
/.php-cs-fixer.dist.php export-ignore

# Local, internal notes; listed in case one is ever committed
/_docs export-ignore
/.junie export-ignore
/.claude export-ignore
/CLAUDE.md export-ignore
